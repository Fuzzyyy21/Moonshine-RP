{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "auth"
  },
  "Auth": {
    "AllowRegistration": false,
    "TicketLifetime": "12:00:00",
    "LoginAttemptsPerMinute": 10
  },
  "PasswordHash": {
    "MemoryKiB": 65536,
    "Iterations": 3,
    "Parallelism": 1
  }
}
